{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "noEmitOnError": true,
    "outDir": "web/static",
    "rootDir": "web/frontend",
    "sourceMap": false
  },
  "include": ["web/frontend/**/*.ts", "web/frontend/**/*.d.ts"],
  "exclude": ["web/frontend/**/*.test.ts"]
}
